# Copy to .env and fill in. Everything here is server-side only: no value in
# this file may ever take a NEXT_PUBLIC_ prefix.

# OpenAI. Used by the generator, verifier, classifier and OCR calls.
OPENAI_API_KEY=

# Supabase Postgres, project <project-ref>.
# Both strings come from the Supabase dashboard:
#   Project Settings > Database > Connection string > ORM
#
# DATABASE_URL is the POOLER connection on port 6543 (transaction mode).
# Every application query goes through it. Paste the dashboard's ORM string
# and keep both of its query parameters:
#
#   pgbouncer=true      stops Prisma using prepared statements the pooler
#                       cannot hold
#   connection_limit=8  sizes Prisma's own client-side pool
#
# That is connection_limit=8, NOT the 1 this file used to suggest
# (DECISIONS.md D-115). At 1 every Promise.all in a server component
# serialises: the Learn index fires seven queries and they queue through a
# single connection. Measured against this database: 1445ms at =1, 245ms at
# =8. The "=1" advice exists for high-concurrency multi-tenant serverless,
# where hundreds of instances each holding a pool would exhaust the pooler.
# This app is single-user by design, so it does not apply.
#
# Set the SAME value in the Vercel project environment. A code deploy does
# not move it.
DATABASE_URL=

# DIRECT_URL is the DIRECT connection on port 5432, same credentials and host
# as above. Prisma uses it only for migrate and introspect, which take
# advisory locks the transaction-mode pooler cannot hold.
DIRECT_URL=

# Wolfram Alpha Full Results API AppID (developer.wolframalpha.com, product:
# Full Results API). Server-side only, same rules as OPENAI_API_KEY: no
# NEXT_PUBLIC_ prefix, never sent to the client. Leave blank to run problem
# verification entirely on the LLM fallback path; the app is fully functional
# without it by design (spec section 10).
WOLFRAM_APP_ID=

# Login wall (DECISIONS.md D-105 to D-109). All three are server-side only.
#
# SESSION_SECRET signs the session cookie (HMAC-SHA256). Generate one with:
#   openssl rand -hex 32
# A deployment takes its OWN secret, generated fresh: never reuse the local
# one. Rotating it invalidates every outstanding session, which is the only
# revocation the app has (DECISIONS.md D-112).
SESSION_SECRET=

# The single admin account. Read only by scripts/seed-admin.ts, which is the
# only way accounts are created: there is no public signup. Prefer passing
# both inline when running the script instead of storing them here.
ADMIN_USERNAME=
ADMIN_PASSWORD=
